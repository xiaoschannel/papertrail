# Credentials, copied to .env (which is gitignored and never leaves this machine). See env.py for
# which file is read when a checkout or worktree has none of its own.

# The hosted extractors (Parse, the Workshop, the Experiment bench) call OpenAI with this.
# Without it the local models still work and the hosted ones fail with "Missing credentials".
OPENAI_API_KEY=

# Optional, and the app never reads it: `python tools/rate_limits.py` uses it to print the project's
# per-model rate limits, which is where a run's pacing headroom comes from. An admin key can manage
# the whole organization, so keep it out of anything that runs unattended, or leave this blank and
# read the limits off the response headers instead (the Parse panel shows what a run is using).
OPENAI_ADMIN_KEY=
